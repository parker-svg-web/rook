# ============================================================
# Rook — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-random-secret

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_id
STRIPE_PRICE_STARTER_ANNUAL=price_starter_annual_id
STRIPE_PRICE_GROWTH_MONTHLY=price_growth_monthly_id
STRIPE_PRICE_GROWTH_ANNUAL=price_growth_annual_id
STRIPE_OVERAGE_PRICE_ID=price_overage_id

# Provider API Keys (for the gateway to forward calls)
ROOK_TWILIO_API_KEY=your_twilio_api_key
ROOK_TWILIO_ACCOUNT_SID=your_twilio_account_sid
ROOK_SENDGRID_API_KEY=your_sendgrid_api_key
ROOK_OPENAI_API_KEY=your_openai_api_key

# Turso (Production database)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token